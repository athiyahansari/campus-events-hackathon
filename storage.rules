rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isOrganizerFor(eventId) {
      let event = firestore.get(/databases/(default)/documents/events/$(eventId)).data;
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return request.auth != null
        && user.role == 'organizer'
        && event.organizerId == request.auth.uid
        && event.club == user.club;
    }

    match /event_banners/{eventId}.jpg {
      allow read: if true;
      allow write: if isOrganizerFor(eventId) && request.resource.size < 10 * 1024 * 1024;
    }

    match /event_archives/{eventId}/{photo} {
      allow read: if true;
      allow write: if isOrganizerFor(eventId) && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
