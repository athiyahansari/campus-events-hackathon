rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOrganizer() {
      return isSignedIn() && userData().role == 'organizer';
    }

    function isAdmin() {
      return isSignedIn() && userData().role == 'admin';
    }

    // An organizer can only publish once the global admin has reviewed and approved their
    // account — until then they can create events and save drafts, but not publish.
    function isApprovedOrganizer() {
      return isOrganizer();
    }

    // An organizer's own club must match the event's category — events are always
    // categorized under the organizer's own club/school (enforced in the client's
    // create-event form too, but this is the real boundary).
    function ownsCategory(category) {
      return isOrganizer() && userData().club == category;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ---------------- users ----------------
    match /users/{uid} {
      // The global admin reviews every account, so they can read the whole roster; everyone
      // else can only read their own profile.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Self-signup can only ever create a 'student' or 'organizer' account — 'admin' is
      // provisioned out-of-band (directly in the Firestore console), never through the app.
      // A new organizer always starts unapproved; only the admin update branch below can
      // flip `organizerApproved` to true.
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['student', 'organizer']
        && request.resource.data.organizerApproved == false
        && (request.resource.data.role == 'student' || request.resource.data.club is string);

      // Name/interests are editable; role/club are immutable after signup to block privilege escalation.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && unchanged('role')
        && unchanged('club')
        && unchanged('organizerApproved');

      // The admin reviews an organizer's account and approves/revokes it — the only field
      // they're allowed to touch on someone else's profile.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizerApproved']);

      allow delete: if false;
    }

    // ---------------- events ----------------
    match /events/{eventId} {
      allow read: if resource.data.status in ['published', 'archived']
        || ownsCategory(resource.data.category);

      // An unapproved organizer can still create events, just not published ones — they land
      // as drafts until the admin approves the account (see isApprovedOrganizer()).
      allow create: if isOrganizer()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.category == userData().club
        && request.resource.data.registeredCount == 0
        && request.resource.data.checkedInCount == 0
        && request.resource.data.status in ['draft', 'published']
        && (request.resource.data.status == 'draft' || isApprovedOrganizer());

      // (a) Organizer manages their own club's event (can't reassign owner/category to dodge the
      //     rule) — this is also the only path that can touch activeCheckinToken/tokenGeneratedAt,
      //     so only the owning organizer can start/rotate/stop a check-in session.
      // (b) Student registration: the ONLY write a student can make to this collection is an
      //     atomic +1 to registeredCount, and only while the event is published and under capacity.
      // (c) Student self-check-in: the ONLY write a checking-in student can make is an atomic +1
      //     to checkedInCount. The real gate (did they present a valid, current token?) lives on
      //     the matching registrations/{id} update below — this is just the denormalized counter.
      allow update: if (
          ownsCategory(resource.data.category)
          && unchanged('organizerId')
          && unchanged('category')
          // Draft -> published (or staying published) requires an approved organizer account;
          // every other transition (e.g. published -> concluded, editing a draft) is unaffected.
          && (request.resource.data.status != 'published' || unchanged('status') || isApprovedOrganizer())
        ) || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount'])
          && request.resource.data.registeredCount == resource.data.registeredCount + 1
          && resource.data.status == 'published'
          && resource.data.registeredCount < resource.data.capacity
        ) || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedInCount'])
          && request.resource.data.checkedInCount == resource.data.checkedInCount + 1
        ) || (
          // Student joins the waitlist: only when the event is actually full.
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waitlistCount'])
          && request.resource.data.waitlistCount == resource.data.waitlistCount + 1
          && resource.data.status == 'published'
          && resource.data.registeredCount >= resource.data.capacity
        );

      allow delete: if false;
    }

    // ---------------- registrations ----------------
    match /registrations/{registrationId} {
      function event() {
        return get(/databases/$(database)/documents/events/$(resource.data.eventId)).data;
      }
      function newEvent() {
        return get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data;
      }

      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || ownsCategory(event().category)
      );

      // Deterministic id ('<eventId>_<uid>') blocks a user from registering twice under
      // different doc ids, enforced here in addition to the client-side transaction check.
      allow create: if isSignedIn() && (
        (
          request.resource.data.userId == request.auth.uid
          && request.resource.data.checkedIn == false
          && registrationId == request.resource.data.eventId + '_' + request.auth.uid
          && newEvent().status == 'published'
          && newEvent().registeredCount < newEvent().capacity
        ) || (
          // Organizer promotes a waitlisted student into a just-released seat.
          ownsCategory(newEvent().category)
          && request.resource.data.checkedIn == false
          && registrationId == request.resource.data.eventId + '_' + request.resource.data.userId
        )
      );

      // Organizer releases a no-show's seat (frees capacity and/or makes room to promote
      // the next waitlisted student).
      allow delete: if isSignedIn() && ownsCategory(event().category);

      // Self-check-in: a student can only flip their OWN registration to checkedIn, and only by
      // submitting a lastCheckinToken that matches the event's live activeCheckinToken at the
      // moment of the write (read fresh via get(), not trusted from the client otherwise). This
      // is what makes a screenshotted/expired QR fail once the organizer's display has rotated.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkedIn', 'checkedInAt', 'lastCheckinToken'])
        && resource.data.checkedIn == false
        && request.resource.data.checkedIn == true
        && event().activeCheckinToken != null
        && request.resource.data.lastCheckinToken == event().activeCheckinToken;

      // Note: `reminderSent` is only ever written by the sendEventReminders Cloud Function
      // (functions/index.js) via the Admin SDK, which bypasses these rules entirely — no
      // client-side rule needed for it.

      // A checked-in student requests their participation certificate once the event (which
      // must have certificates enabled) has ended.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['certificateRequested', 'certificateRequestedAt'])
        && resource.data.checkedIn == true
        && request.resource.data.certificateRequested == true
        && event().certificateEnabled == true
        && request.time > event().endTime;
    }

    // ---------------- waitlist ----------------
    match /waitlist/{waitlistId} {
      function wlEvent() {
        return get(/databases/$(database)/documents/events/$(resource.data.eventId)).data;
      }
      function newWlEvent() {
        return get(/databases/$(database)/documents/events/$(request.resource.data.eventId)).data;
      }

      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || ownsCategory(wlEvent().category)
      );

      // A student can only join the waitlist for themselves, and only once the event is
      // actually full — mirrors the registrations create rule above.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && waitlistId == request.resource.data.eventId + '_' + request.auth.uid
        && newWlEvent().status == 'published'
        && newWlEvent().registeredCount >= newWlEvent().capacity;

      // Organizer removes an entry when promoting the student to a released seat.
      allow delete: if isSignedIn() && ownsCategory(wlEvent().category);

      allow update: if false;
    }

    // ---------------- notifications ----------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Organizer notifying a promoted waitlisted student. The day-before-reminder and
      // missed-events Cloud Functions (functions/index.js) also write here via the Admin
      // SDK, which bypasses these rules entirely.
      allow create: if isOrganizer()
        && request.resource.data.keys().hasOnly(['userId', 'title', 'body', 'read', 'createdAt'])
        && request.resource.data.read == false;

      // Recipient can only mark their own notification as read.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }
  }
}
